{
  "name": "stivium",
  "version": "0.1.0",
  "description": "Stivium — BNB Chain AI Agent Marketplace",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bsc",
    "register:agent:testnet": "python3 scripts/register-agent.py --network bsc-testnet",
    "register:agent:mainnet": "python3 scripts/register-agent.py --network bsc-mainnet",
    "test": "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  },
  "engines": {
    "node": "24.x"
  }
}
