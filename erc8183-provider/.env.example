# Copy to .env and fill locally. Never commit private credentials.

# BNB Agent SDK network: bsc-testnet (97) or bsc-mainnet (56)
NETWORK=bsc-testnet

WALLET_PASSWORD=<SET_IN_LOCAL_ENV>
PRIVATE_KEY=<SET_IN_LOCAL_ENV>

# Public HTTPS provider URL. Used by both ERC-8004 and ERC-8183.
A2A_BASE_URL=https://YOUR_PROVIDER_HOST
ERC8183_AGENT_URL=https://YOUR_PROVIDER_HOST/erc8183

AGENT_NAME=STIVIUM Yield Guardian
AGENT_DESCRIPTION=STIVIUM agent for bounded yield optimisation and on-chain ERC-8183 jobs.
ERC8183_SERVICE_PRICE=1000000000000000000

ERC8183_FUNDED_POLL_INTERVAL=30
ERC8183_NEGOTIATE_RATE_LIMIT=120
ERC8183_NEGOTIATE_GLOBAL_RATE_LIMIT=1200
ERC8183_NEGOTIATE_RATE_WINDOW=60
ERC8183_MAX_RESPONSE_BYTES=5242880
ERC8183_MAX_METADATA_BYTES=262144
